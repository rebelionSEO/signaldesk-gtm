# Configure these as server-side runtime variables; never expose them to browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Required before paid stages. Leave blank to disable spending.
# Study allowance persists across retries, edits and restarts.
SIGNALDESK_RUN_BUDGET_USD=
# Operator-verified maximum charge for one request envelope, including search.
# This is NOT an automatically calculated price; see docs/process/RUN_CONTROLS.md.
OPENAI_MAX_CALL_USD=
